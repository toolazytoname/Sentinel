{
    "_comment": "Hyperopt / backtest 专用配置 — 不带 dry_run/api_server/telegram，避免 trade 模式噪音。",
    "_sentinel_phase": "P1.4 hyperopt",

    "max_open_trades": 3,
    "stake_currency": "USDT",
    "stake_amount": 50,
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "USD",
    "timeframe": "1d",

    "dry_run": true,
    "dry_run_wallet": 1000,

    "rotation_pairs": [
        "BTC/USDT", "ETH/USDT", "BNB/USDT", "XRP/USDT", "SOL/USDT",
        "TRX/USDT", "DOGE/USDT", "ZEC/USDT", "ADA/USDT", "LINK/USDT",
        "XLM/USDT", "BCH/USDT", "GRAM/USDT", "LTC/USDT", "HBAR/USDT"
    ],

    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "pair_whitelist": [
            "BTC/USDT", "ETH/USDT", "BNB/USDT", "XRP/USDT", "SOL/USDT",
            "TRX/USDT", "DOGE/USDT", "ZEC/USDT", "ADA/USDT", "LINK/USDT",
            "XLM/USDT", "BCH/USDT", "GRAM/USDT", "LTC/USDT", "HBAR/USDT"
        ],
        "pair_blacklist": [".*UP/.*", ".*DOWN/.*"],
        "markets_refresh_interval": 1000000,
        "ccxt_config": {
            "enableRateLimit": true,
            "aiohttp_trust_env": true
        },
        "ccxt_async_config": {
            "enableRateLimit": true,
            "aiohttp_trust_env": true
        }
    },

    "trading_mode": "spot",
    "margin_mode": "",

    "pairlists": [
        {"method": "StaticPairList"}
    ],

    "stoploss": -0.10,
    "stoploss_on_exchange": true,

    "entry_pricing": {"price_side": "same", "use_order_book": false},
    "exit_pricing": {"price_side": "same", "use_order_book": false},

    "db_url": "sqlite:///:memory:",
    "verbosity": 0,
    "dataformat_ohlcv": "json",

    "strategy": "S1TrendFollow"
}
