{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "Sentinel historical practice",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "trading_mode": "spot",
  "margin_mode": "",
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": 50,
  "tradable_balance_ratio": 0.99,
  "timeframe": "4h",
  "strategy": "S1TrendFollow",
  "stoploss": -0.10,
  "stoploss_on_exchange": true,
  "dataformat_ohlcv": "json",
  "entry_pricing": {"price_side": "same", "use_order_book": false},
  "exit_pricing": {"price_side": "same", "use_order_book": false},
  "order_types": {
    "entry": "limit", "exit": "limit", "stoploss": "market",
    "stoploss_on_exchange": true
  },
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "password": "",
    "pair_whitelist": ["BTC/USDT", "ETH/USDT"],
    "pair_blacklist": [],
    "ccxt_config": {
      "enableRateLimit": true,
      "timeout": 10000,
      "urls": {"api": {"public": "https://data-api.binance.vision/api/v3"}},
      "options": {"defaultType": "spot", "fetchMarkets": {"types": ["spot"]}, "fetchCurrencies": false}
    },
    "ccxt_async_config": {
      "enableRateLimit": true,
      "timeout": 10000,
      "aiohttp_trust_env": true,
      "urls": {"api": {"public": "https://data-api.binance.vision/api/v3"}},
      "options": {"defaultType": "spot", "fetchMarkets": {"types": ["spot"]}, "fetchCurrencies": false}
    }
  },
  "pairlists": [{"method": "StaticPairList"}],
  "telegram": {"enabled": false, "token": "", "chat_id": ""},
  "api_server": {
    "enabled": false,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8080,
    "username": "",
    "password": "",
    "jwt_secret_key": "historical-replay-disabled-api-dummy-key"
  },
  "webhook": {"enabled": false}
}
